# Environment configuration for EnvPulse
# Copy to .env and configure with your values

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Athena Configuration
ATHENA_DB=envpulse_db
ATHENA_TABLE=signals
S3_OUTPUT=s3://envpulse-athena-results-YOUR-ACCOUNT-ID/

# Alert Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_THRESHOLD=2
FAILURE_WINDOW_MINUTES=60

# Lambda Configuration
QUERY_TIMEOUT_SECONDS=120
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
LOG_LEVEL=INFO

# Optional: PagerDuty Integration
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# Optional: Email Alerts
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENTS=

# Feature Flags
ENABLE_SLACK_ALERTS=true
ENABLE_EMAIL_ALERTS=false
ENABLE_PAGERDUTY_ALERTS=false
